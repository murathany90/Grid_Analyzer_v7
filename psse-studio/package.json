{
  "name": "grid-analyzer-psse-studio",
  "version": "13.0.0",
  "description": "Offline modular PSS/E Studio",
  "main": "dist/psse-module.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:integration": "node --test tests/standalone-sld.test.mjs tests/sld-codec.test.mjs tests/sld-ui.test.mjs tests/data-types.test.mjs tests/sld-model.test.mjs tests/sld-results.test.mjs",
    "test:sld:pilots": "node tests/sld-v4-pilots.mjs",
    "verify": "npm run build && npm test && npm run test:browser",
    "benchmark": "node tests/benchmark.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.8",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32"
  },
  "private": true,
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "types": "src/modules/psse/contracts.d.ts",
  "exports": {
    ".": {
      "types": "./src/modules/psse/contracts.d.ts",
      "import": "./dist/psse-module.js"
    },
    "./style.css": "./dist/psse-module.css"
  }
}
