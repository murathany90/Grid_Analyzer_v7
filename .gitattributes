# Real control1 JSON models are local-only; do not track them with Git or LFS.

# The single-file portable build is a release artifact that is benchmarked and hashed
# byte-for-byte. Its bytes must not depend on the checkout platform.
#
# `text eol=lf` normalises the committed blob to LF and checks LF out on every platform, so
# the committed hash is reproducible. The portable plugin additionally normalises the
# emitted HTML, JS and CSS to LF, because source line endings otherwise survive into the
# artifact: a CRLF checkout produced different bytes than an LF checkout and the committed
# hash could never match a CI build.
dist-portable/*.html text eol=lf

# Source text is normalised too, so the bundled code that goes into the artifact is
# identical everywhere. Without this the artifact still varied by platform.
*.ts text eol=lf
*.mts text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Binary assets must never be line-ending normalised.
licenses/** binary
**/*.png binary
**/*.jpg binary
**/*.wasm binary